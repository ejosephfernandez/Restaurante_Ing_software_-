            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Mesa inicia DISPONIBLE', () => pm.expect(pm.response.json().estado).to.eql('DISPONIBLE'));",
