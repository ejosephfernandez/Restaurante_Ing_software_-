              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Requiere el usuario MESERO descrito en la documentacion de la coleccion."
          }
        },
